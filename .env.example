PORT=3780
NODE_ENV=development
WEBHOOK_SECRET=change_me
ENABLE_DEV_TOOLS=1

# Security/rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
SESSION_TTL_MS=2592000000

# Admin access (invitation only — not shown in public sign-up UI)
# Comma-separated emails allowed to register as admin (also kept as admin on every server start):
# ALLOWED_ADMIN_EMAILS=you@example.com,teammate@example.com
# Or set a secret code you share privately with your team:
# ADMIN_INVITE_CODE=your-long-secret-code

# Postgres — required before any public launch. Never reuse a password that has
# appeared in a terminal, chat, screenshot, or committed file.
# Get a fresh URI from Supabase: Project Settings → Database → Connection string.
# Use the pooler URI for a hosted deployment and the direct URI for migrations.
# Replace [YOUR-PASSWORD] with your database password (URL-encode special chars: @ → %40)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
# PGSSL=1

# Supabase project (optional — for future Supabase Auth/Storage client; NOT used by Garden today)
# SUPABASE_URL=https://fvtrigllwujrccryfiep.supabase.co
# SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Customer checkout is M-Pesa only. Set to 1 in production with MPESA_* credentials
# (or configure them in Admin → M-Pesa). Keep 0 only while using local demo confirm.
WALLET_PAYMENTS_ENABLED=0

# Platform M-Pesa payout wallet (pays vendors & drivers daily — Admin → Finance)
# PAYOUT_MPESA_ENABLED=0
# PAYOUT_MPESA_ACCOUNT_NAME=Garden Tanzania Ltd
# PAYOUT_MPESA_ACCOUNT_TYPE=till
# PAYOUT_MPESA_ACCOUNT_NUMBER=
# PAYOUT_MPESA_ACCOUNT_REF=
# PAYOUT_MPESA_NOTES=

# M-Pesa / Safaricom Daraja (required for live customer payments — or Admin → M-Pesa)
# MPESA_ENABLED=1
# MPESA_ENVIRONMENT=sandbox
# MPESA_SHORT_CODE=174379
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# PUBLIC_APP_URL=https://your-app.onrender.com
# Native mobile apps (Capacitor) load this HTTPS URL inside Android/iOS shells.
# GARDEN_APP_URL=https://your-app.onrender.com
# GARDEN_APP_ID=tz.garden.app
# GARDEN_APP_NAME=garden

# Reserved for a future shared rate-limit/session implementation.
# REDIS_URL=redis://localhost:6379
SMS_PROVIDER_API_KEY=
SMS_WEBHOOK_URL=
SMS_SENDER_ID=Garden
EMAIL_API_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=garden <onboarding@resend.dev>
PAYMENT_PROVIDER_API_KEY=
